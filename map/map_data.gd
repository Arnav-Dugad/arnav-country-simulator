class_name MapData
extends Resource
## Baked world geometry + metadata (generated by tools/bake_map.gd).
## Coordinates are Equal Earth projected units (1000 per radian, y down).

@export var source: String = ""
@export var world_rect: Rect2

# Per-country metadata (index = country index)
@export var iso3: PackedStringArray
@export var iso2: PackedStringArray
@export var names: PackedStringArray
@export var names_long: PackedStringArray
@export var continents: PackedStringArray
@export var subregions: PackedStringArray
@export var regions_wb: PackedStringArray
@export var types: PackedStringArray
@export var label_pos: PackedVector2Array
@export var label_rank: PackedInt32Array
@export var area: PackedFloat32Array
@export var bbox_pos: PackedVector2Array
@export var bbox_size: PackedVector2Array
@export var pop_est: PackedFloat64Array
@export var gdp_md: PackedFloat64Array
@export var neighbours: Array[PackedInt32Array] = []
## Capital city per country (position NAN if unknown).
@export var capital_pos: PackedVector2Array
@export var capital_name: PackedStringArray

# Geometry: simplified outer rings and their triangulations
@export var ring_points: Array[PackedVector2Array] = []
@export var ring_country: PackedInt32Array
@export var ring_tris: Array[PackedInt32Array] = []

var _index: Dictionary = {}


func count() -> int:
	return iso3.size()


func index_of(code: String) -> int:
	if _index.is_empty():
		for i in iso3.size():
			_index[iso3[i]] = i
	return _index.get(code, -1)


func bbox(i: int) -> Rect2:
	return Rect2(bbox_pos[i], bbox_size[i])


## Rings belonging to a country.
func rings_of(i: int) -> Array[PackedVector2Array]:
	var out: Array[PackedVector2Array] = []
	for r in ring_country.size():
		if ring_country[r] == i:
			out.append(ring_points[r])
	return out
