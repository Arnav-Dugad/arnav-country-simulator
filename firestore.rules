rules_version = '2';

// Arnav Country Simulator — Cloud Firestore security rules.
// Each signed-in user (anonymous or email) can only read and write documents
// under users/{their own uid}/. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/saves/{slotId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && slotId.matches('slot_[1-9]')
        && request.resource.data.keys().hasOnly(['data', 'size', 'saved_at', 'country', 'date', 'version'])
        && request.resource.data.data is bytes
        && request.resource.data.data.size() < 900 * 1024;
    }

    // Weekly challenge leaderboard: anyone can read; each signed-in player can
    // write only their own entry, with a small, validated set of fields.
    match /weekly/{week}/scores/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && week.matches('W[0-9]{4}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['name', 'country', 'score', 'grade', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.country is string && request.resource.data.country.size() <= 3
        && request.resource.data.grade is string && request.resource.data.grade.size() <= 2
        && request.resource.data.score is number
        && request.resource.data.score >= 0 && request.resource.data.score <= 200
        && request.resource.data.at is int;
    }

    // All-time hall of fame: anyone can read; each player writes only their own entry.
    match /legends/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'country', 'score', 'grade', 'points', 'rank', 'code', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.country is string && request.resource.data.country.size() <= 3
        && request.resource.data.grade is string && request.resource.data.grade.size() <= 2
        && request.resource.data.rank is string && request.resource.data.rank.size() <= 16
        && request.resource.data.code is string && request.resource.data.code.size() <= 8
        && request.resource.data.score is number
        && request.resource.data.score >= 0 && request.resource.data.score <= 200
        && request.resource.data.points is int
        && request.resource.data.points >= 0 && request.resource.data.points <= 100000
        && request.resource.data.at is int;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
